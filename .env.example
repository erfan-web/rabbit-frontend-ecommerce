# Template for the Vite env files.
# Copy values into the matching file — do not commit real secrets.

# ---- .env (shared, gitignored) ----
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# ---- .env.development (npm run dev) ----
VITE_BACKEND_URL=http://localhost:8000/api/

# ---- .env.development.remote (npm run dev:remote) ----
VITE_BACKEND_URL=https://your-production-backend.example/api/

# ---- .env.production (npm run build / Vercel) ----
VITE_BACKEND_URL=https://your-production-backend.example/api/
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
